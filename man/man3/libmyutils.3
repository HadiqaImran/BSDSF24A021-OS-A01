.TH LIBMYUTILS 3 "September 2026" "libmyutils 1.0" "Library Functions"
.SH NAME
libmyutils \- custom C utility library for string and file operations
.SH SYNOPSIS
.B #include "mystrfunctions.h"
.br
.B #include "myfilefunctions.h"
.PP
.BI "int mystrlen(const char *" s );
.br
.BI "int mystrcpy(char *" dest ", const char *" src );
.br
.BI "int mystrncpy(char *" dest ", const char *" src ", int " n );
.br
.BI "int mystrcat(char *" dest ", const char *" src );
.br
.BI "int wordCount(FILE *" file ", int *" lines ", int *" words ", int *" chars );
.br
.BI "int mygrep(FILE *" fp ", const char *" search_str ", char ***" matches );
.SH DESCRIPTION
.B libmyutils
provides custom implementations of common string manipulation functions
and file-based utility functions, available as both a static library
(libmyutils.a) and a dynamic library (libmyutils.so).
.PP
The string functions
.RB ( mystrlen ", " mystrcpy ", " mystrncpy ", " mystrcat )
reimplement standard C string operations from scratch.
.PP
The file functions
.RB ( wordCount ", " mygrep )
provide line/word/character counting and pattern searching over an
open file stream.
